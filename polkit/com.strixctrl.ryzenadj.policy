<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="com.strixctrl.ryzenadj">
    <description>Adjust AMD CPU power limits via ryzenadj</description>
    <message>Authentication required to adjust CPU power limits</message>
    <defaults>
      <!-- allow_any: remote/unauthenticated still requires admin auth -->
      <allow_any>auth_admin</allow_any>
      <!-- allow_inactive: local user process in a non-active session (e.g. a
           systemd user service or D-Bus-activated daemon).  Must be "yes" so
           the daemon can call pkexec without an interactive auth prompt. -->
      <allow_inactive>yes</allow_inactive>
      <!-- allow_active: interactive session, always yes -->
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ryzenadj</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
